<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_nesil_profils">
            <field name="name">Gestion des profil Nesil</field>
            <field name="description">Gestion des profil Nesil</field>
            <field name="sequence">16</field>
        </record>
        <record id="group_nesil_commercial" model="res.groups">
            <field name="name">Profil Equipe Commerciale</field>
            <field name="category_id" ref="module_nesil_profils" />
        </record>
        <record id="group_nesi_rh" model="res.groups">
            <field name="name">Profil RH</field>
            <field name="category_id" ref="module_nesil_profils" />
        </record>
        <record id="group_nesil_be" model="res.groups">
            <field name="name">Profil Bureau Etude</field>
            <field name="category_id" ref="module_nesil_profils" />
        </record>
        <record id="group_nesil_ca" model="res.groups">
            <field name="name">Profil Chef Atelier</field>
            <field name="category_id" ref="module_nesil_profils" />
        </record>
        <record id="group_nesil_menuserie" model="res.groups">
            <field name="name">Profil Menuserie</field>
            <field name="category_id" ref="module_nesil_profils" />
        </record>
        
        <record id="group_nesil_direction" model="res.groups">
            <field name="name">Profil Direction</field>
            <field name="category_id" ref="module_nesil_profils" />
            <field name="implied_ids" eval="[(4, ref('custom_sales.group_nesil_commercial'))]" />
        </record>

        <record id="crm.crm_menu_config" model="ir.ui.menu">
            <field name="name">Configuration</field>
            <field name="groups_id" eval="[(4, ref('custom_sales.group_nesil_direction')),(0, ref('custom_sales.group_nesil_commercial'))]"/>
        </record>
        
        <record id="rule_user_remise" model="ir.rule">
            <field name="name">Gestion des remises</field>
            <field name="model_id" ref="model_nesil_remise"/>
            <field name="groups" eval="[(4, ref('custom_sales.group_nesil_direction'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>
<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data noupdate="1">
        <record model="ir.module.category" id="module_nesil_direction">
            <field name="name">Gestion des profil Nesil</field>
            <field name="description">Gestion des profil Nesil</field>
            <field name="sequence">16</field>
        </record>


        <record id="group_nesil_commerciaux" model="res.groups">
            <field name="name">Profil commerciaux</field>
            <field name="category_id" ref="module_nesil_direction" />
        </record>
        
        <record id="group_nesil_direction" model="res.groups">
            <field name="name">profil direction</field>
            <field name="category_id" ref="module_nesil_direction" />
            <field name="implied_ids" eval="[(4, ref('custom_sales.group_nesil_commerciaux'))]" />
        </record>
        
        <record id="rule_user_remise" model="ir.rule">
            <field name="name">Gestion des remises</field>
            <field name="model_id" ref="model_nesil_remise"/>
            <field name="groups" eval="[(4, ref('custom_sales.group_nesil_commerciaux'))]"/>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
            <field name="domain_force">[(user.employee_id.department_id.nam,'!=','direction')]</field>
        </record>
    </data>
</odoo>
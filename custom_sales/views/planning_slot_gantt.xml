        <record id="view_custom_planning" model="ir.ui.view">
            <field name="name">custom.planning.view</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="planning.planning_view_gantt"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='allocated_hours']" position="after">
                    <field name="task_id"/>
                </xpath>
                <field name="allocated_hours"/>
                <templates>
                    <div t-name="gantt-popover">
                        <p>
                            <div id="task_id">
                                <strong>Nom de la tâche: </strong>
                                <t t-if="task_id"/>
                                <t t-esc="task_id"/>
                            </div>
                        </p>
                        <div id="allocated_hours">
                            <strong>Allocated Time — </strong>
                            <t t-esc="allocatedHoursFormatted"/>
                            <t t-esc="allocatedHoursFormatted"/>
                            <t t-if="resource_type == 'user'"> (<t t-esc="allocatedPercentageFormatted"/>%)</t>
                        </div>
                    </div>
                </templates>
            </field>  
        </record>
    </data>
</odoo>

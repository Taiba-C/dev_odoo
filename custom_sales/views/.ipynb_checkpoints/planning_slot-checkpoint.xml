<odoo>
    <data>
        <record id="view_planning_slot_form_inherit" model="ir.ui.view">
            <field name="name">planning.slot.form.inherit</field>
            <field name="model">planning.slot</field>
            <field name="inherit_id" ref="planning.planning_slot_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <group>
                        <field name="task_id" string="Tasks" widget="many2one"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>


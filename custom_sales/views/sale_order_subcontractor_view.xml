<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
        <record model="ir.ui.view" id="sale_order_subcontractor_form">
            <field name="name">Sous-traitant form</field>
            <field name="model">sale.order.subcontractor</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="partner_id"/>
                    <field name="unit_price"/>
                    <field name="product_template_id"/>
                    <field name="order_line_created"/>
                    <field name="order_line_id"/>
                </tree>
            </field>
        </record>
    
        <record model="ir.ui.view" id="sale_order_subcontractor_list">
            <field name="name">Sous-traitant list</field>
            <field name="model">sale.order.subcontractor</field>
            <field name="arch" type="xml">
                <tree create="false" delete="false">
                    <field name="order_id"/>
                    <field name="partner_id"/>
                    <field name="product_template_id"/>
                    <field name="cost_price"/>
                    <field name="unit_price"/>
                    <field name="state" decoration-success="state == 'sale' or state == 'done'" decoration-info="state == 'draft'" widget="badge" optional="show" />
                    <field name="order_line_created" invisible="1"/>
                    <field name="order_line_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="custom_sales.action_window">
            <field name="name">custom_sales window</field>
            <field name="res_model">sale.order.subcontractor</field>
            <field name="view_mode">tree,form</field>
        </record>
    
    </data>
    

</odoo>

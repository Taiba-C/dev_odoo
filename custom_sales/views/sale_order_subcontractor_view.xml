<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <data>
    
        <record model="ir.ui.view" id="sale_order_subcontractor_list">
            <field name="name">Sous-traitant list</field>
            <field name="model">sale.order.subcontractor</field>
            <field name="arch" type="xml">
                <tree create="false" delete="false">
                    <field name="order_id"/>
                    <field name="partner_id"/>
                    <field name="product_template_id"/>
                    <field name="cost_price"/>
                    <field name="unit_price"/>
                    <field name="state" decoration-success="state == 'sale' or state == 'done'" decoration-info="state == 'draft'" widget="badge" optional="show" />
                    <field name="order_line_created" invisible="1"/>
                    <field name="order_line_id" invisible="1"/>
                </tree>
            </field>
        </record>

        <record model="ir.actions.act_window" id="subcontractor_action">
            <field name="name">Sous-traitance</field>
            <field name="res_model">sale.order.subcontractor</field>
            <field name="context">{'search_default_partner_id': 1}</field>

            <field name="view_mode">tree</field>
        </record>

        <record id="sale_order_subcontractor_view_search" model="ir.ui.view">
            <field name="name">Recherche sous-traitant</field>
            <field name="model">sale.order.subcontractor</field>
            <field name="arch" type="xml">
                <search string="">
                    <filter name="partner_id" string="Sous-traitant" icon="terp-partner" context="{'group_by':'partner_id'}"/>
                </search>
            </field>
        </record>

        <menuitem
            id="subcontractor_menu"
            name="Sous-traitance"
            action="subcontractor_action"
            parent="sale.sale_menu_root"
            sequence="10"/>
    
    </data>
    

</odoo>

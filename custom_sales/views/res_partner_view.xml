<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
    
        <record id="view_partner_for_sale_order_nesil" model="ir.ui.view">
            <field name="name">res.partner.for.sale.order.nesil</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='company_registry']" position="after">
                    <field name="is_subcontractors"/>
                    <field name="subcontractor_margin" widget="percentage" attrs="{ 'invisible': [('is_subcontractors', '=', False)]}"/>
                </xpath>
            </field>
        </record>

        <!-- filter -->
        <record id="res_partner_view_search_nesil" model="ir.ui.view">
            <field name="name">res.partner.search.nesil</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_res_partner_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='inactive']" position="after">
                    <separator/>
                    <filter string="Sous-traitant" name="subcontract" domain="[('is_subcontractors','=', True)]"/>
                    <separator/>
                </xpath>
            </field>
        </record>
    
    </data>
    
</odoo>
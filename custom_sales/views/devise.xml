<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record model="ir.ui.view" id="view_nesil_devise_form">
		<field name="name">nesil.devise.form</field>
		<field name="model">nesil.devise</field>
		<field name="arch" type="xml">
			<form string="Devise">
				<sheet>
                <group>
					<field name="devise" />
					<field name="taux_de_remise" />
                    <field name="date_de_remise" />
                    <field name="active" widget="boolean_toggle" />
                </group>
				</sheet>
			</form>
		</field>
	</record>
	<record id="view_nesil_devise_tree" model="ir.ui.view">
		<field name="name">devise.tree</field>
		<field name="model">nesil.devise</field>
		<field name="arch" type="xml">
			<tree string="Devise">
					<field name="devise" />
					<field name="taux_de_remise" />
                    <field name="date_de_remise" />
			</tree>
		</field>
	</record>
	
	<record model="ir.actions.act_window" id="nesil_devise">
		<field name="name">Devise</field>
		<field name="res_model">nesil.devise</field>
		<field name="view_mode">tree,form</field>
	</record>
</odoo>

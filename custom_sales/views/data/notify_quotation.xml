<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Quotation Expired -->
        <record id="ir_cron_data_notify_quotation_expired" model="ir.cron">
            <field name="name">Sale order: Quotation expired</field>
            <field name="model_id" ref="model_sale_order"/>
            <field name="type">ir.actions.server</field>
            <field name="state">code</field>
            <field name="code">model.notify_quotation_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="nextcall" eval="(datetime.datetime.now().replace(hour=9, minute=00, second=0) + datetime.timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S')" />
        </record>
    </data>
</odoo>
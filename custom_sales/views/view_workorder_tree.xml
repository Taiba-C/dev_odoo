<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Action pour accéder à la vue des ordres de travail -->
        <record id="action_view_workorder" model="ir.actions.act_window">
            <field name="name">Work Orders</field>
            <field name="res_model">mrp.workorder</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_workorder_tree_inherit"/>
            <field name="domain">[('user_id', '=', uid)]</field>
        </record>

        <!-- Menu pour accéder à la vue des ordres de travail -->
        <menuitem id="menu_mrp_workorders" name="Mes Ordres de travail" parent="mrp.menu_mrp_root" action="action_view_workorder"/>
    </data>
</odoo>
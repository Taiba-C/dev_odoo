<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="form_sale_order_custom" model="ir.ui.view">
            <field name="name">Details de devis</field>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_invoice']" position="before">
                    <button type="object" name="action_view_planning" string="Planning" class="oe_stat_button" attrs="{ 'invisible': [('project_option_counts', '=', 0)] }" icon="fa-puzzle-piece">
                    </button>
                    <button type="object" name="action_view_project_option_ids" attrs="{ 'invisible': [('project_option_counts', '=', 0)] }" class="oe_stat_button" icon="fa-puzzle-piece">
                        <field name="project_option_counts" widget="statinfo" string="Projects"/>
                    </button>
                    <button type="object" name="action_view_task_option_ids" attrs="{ 'invisible': [('project_option_counts', '=', 0)] }" class="oe_stat_button" icon="fa-puzzle-piece">
                        <field name="task_option_counts" widget="statinfo" string="Tasks"/>
                    </button>
                    <button type="object" name="action_view_manufacturation_orders" attrs="{'invisible': [('mrp_production_counts', '=', 0)]}" class="oe_stat_button" icon="fa-puzzle-piece">
                        <field name="mrp_production_counts" widget="statinfo" string="Ordres de fabrication"/>
                    </button>
                </xpath>
                <xpath expr="//button[@name='action_view_delivery']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">

                    <button name="action_show_manufactured_order" icon="fa-pencil-square-o" type="object" string="Fabrication" attrs="{'invisible': [('state', '!=', 'sale')]}" class="oe_highlight"/>

                </xpath>


                <!-- <xpath expr="//field[@name='sale_order_template_id']" position="after">

                    <button name="generate_bom_order" attrs="{ 'invisible': [('state', '!=', 'draft')] }" string="Encryption" type="object" class="oe_highlight"/>

                </xpath> -->

                <xpath expr="//field[@name='payment_term_id']" position="after">

                    <field name="date_of_exhibition" attrs="{'readonly': [('state','not in',['draft','sent'])]}"/>
                    <field name="picking_id" readonly="1" force_save="1"/>
                    <field name="validity_quotation" readonly="1" invisible="1"/>
                    <field name="is_bom_generated" invisible="1"/>


                </xpath>


                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='product_id']" position="attributes">

                    <attribute name="domain">[('is_bom_parent', '=', False)]</attribute>

                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='name']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='uom_id']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='price_unit']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']/tree/button[@name='button_add_to_order']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='product_id']" position="before">
                    <field name="order_line_id" domain="[('order_id', '=', parent.id),('display_type', '=', False)]" options="{'no_create': True, 'no_create_edit':True}"/>
                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='quantity']" position="before">
                    <field name="purchase_price" />

                </xpath>

                <!-- always show sale_order_option_ids -->
                <xpath expr="//page[@name='optional_products']" position="attributes">
                    <attribute name="attrs">{'readonly':[('state','=',['cancel'])]}</attribute>
                </xpath>


                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='quantity']" position="after">
                    <field name="margin_product" string =" Ratios"/>
                    <field name="total_purchase_price" force_save = "1"/>
                    <field name="total_sale_price" force_save = "1"/>
                    <field name="margin" force_save = "1"/>
                    <field name="margin_percent" widget="percentage" force_save = "1"/>
                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']" position="after">
                    <group name="note_group" col="6" class="mt-2 mt-md-0">
                        <group colspan="4">

                        </group>

                        <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">

                            <field name="total_purchase"  widget ="monetary" force_save="1"/>

                            <field name="total_sale"  widget ="monetary" force_save="1"/>

                            <field name="margin"  widget ="monetary" force_save="1"/>

                            <field name="margin_percent" widget ="percentage" force_save="1"/>

                        </group>
                        <div class="clearfix"/>
                    </group>


                </xpath>


                <!-- hide field in order line -->
                <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="attributes">
                    <attribute name="domain">['|', ('is_bom_parent', '=', True),('detailed_type', '=', 'service')]</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/form/group/group/div[@name='ordered_qty']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page/field[@name='order_line']/tree/field[@name='product_uom'][2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='customer_lead']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='qty_delivered']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- add cunsumable-->
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="before">

                    <field name="consumable" readonly="1" force_save="1" />
                </xpath>

                <!-- add custom qty -->
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">

                    <field name="qty" attrs="{ 'readonly': [('state', '!=', 'draft')] }" />
                    <field name="temp_price_unit" readonly="1" force_save="1"/>

                </xpath>

                <!-- change name -->
                <xpath expr="//page[@name='optional_products']" position="attributes">

                    <attribute name="string">Costing table</attribute>

                </xpath>
                <xpath expr="//page[@name='order_lines']" position="attributes">

                    <attribute name="string">Details of the quotation</attribute>

                </xpath>

                <!-- add button for costing table -->
                <xpath expr="//field[@name='order_line']/tree/field[@name='qty']" position="before">
                    <button name="action_costing" string="Chiffrer" type="object" class="oe_highlight"/>
                </xpath>
            </field>
        </record>

        <record id="view_order_form_inherit_sale_project_inherited" model="ir.ui.view">
            <field name="name">sale.order.form.sale.project</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="industry_fsm_sale.view_order_form_inherit_sale_project"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree/field[@name='task_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
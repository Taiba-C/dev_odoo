<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <data>
        <record id="form_sale_order_custom" model="ir.ui.view">
            <field name="name">Details de devis</field>
            <field name="model">sale.order</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//button[@name='action_view_invoice']" position="before">
                    <button type="object" name="action_view_planning" string="Planning" class="oe_stat_button" attrs="{ 'invisible': [('project_option_counts', '=', 0)] }" icon="fa-puzzle-piece">
                    </button>
                    <button type="object" name="action_view_project_option_ids" attrs="{ 'invisible': [('project_option_counts', '=', 0)] }" class="oe_stat_button" icon="fa-puzzle-piece">
                        <field name="project_option_counts" widget="statinfo" string="Projects"/>
                    </button>
                    <button type="object" name="action_view_task_option_ids" attrs="{ 'invisible': [('project_option_counts', '=', 0)] }" class="oe_stat_button" icon="fa-puzzle-piece">
                        <field name="task_option_counts" widget="statinfo" string="Tasks"/>
                    </button>
                    <button type="object" name="action_view_manufacturation_orders" attrs="{'invisible': [('mrp_production_counts', '=', 0)]}" class="oe_stat_button" icon="fa-puzzle-piece">
                        <field name="mrp_production_counts" widget="statinfo" string="Ordres de fabrication"/>
                    </button>
                    <button type="object" name="get_amount_to_pay" class="oe_stat_button" icon="fa-pencil-square-o">
                        <field name="amount_to_pay" widget="statinfo" string="Reste à facturer"/>
                    </button>
                </xpath>
                <!-- <xpath expr="//button[@name='action_view_delivery']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath> -->
                <page name="optional_products" position="before">
                <page string="Costing table"
                    name="optional_products_nesil"
                    attrs="{'invisible': [('state', 'not in', ['draft', 'sent'])]}">
                    <field name="sale_order_nesil_option_ids" mode="tree,form">
                        <form string="Tableau de chiffrage ">
                            <group>
                                <!-- <field name="product_id_domain" invisible="1"/> -->
                                <field name="product_id" options="{'no_create': True, 'no_create_edit':True}" />
                                <field name="name"/>
                                <field name="quantity"/>
                                <field name="product_uom_category_id" invisible="1"/>
                                <field name="uom_id" groups="uom.group_uom"/>
                                <field name="price_unit"/>
                                <field name="discount" groups="product.group_discount_per_so_line"/>
                                <field name="is_present" />
                            </group>
                        </form>
                        <tree string="Sales Quotation Template Lines"
                            editable="bottom"
                            decoration-success="is_present == True">
                            <control>
                                <create name="add_product_control" string="Add a product"/>
                            </control>
                            <field name="sequence" widget="handle"/>
                            <!-- <field name="product_id_domain" invisible="1"/> -->
                            <field name="product_id" domain="[('is_bom_parent', '=', False)]" options="{'no_create': True, 'no_create_edit':True}" />
                            <field name="name" optional="show"/>
                            <field name="quantity"/>
                            <field name="margin_product" string =" Ratios"/>
                            <field name="total_purchase_price" force_save = "1"/>
                            <field name="total_sale_price" force_save = "1"/>
                            <field name="margin" force_save = "1"/>
                            <field name="margin_percent" widget="percentage" force_save = "1"/>

                            <field name="uom_id" string="UoM" groups="uom.group_uom" optional="show"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="price_unit"/>
                            <field name="discount"
                                string="Rem.%"
                                groups="product.group_discount_per_so_line"
                                optional="show"/>
                            <field name="is_present" invisible="1" />
                            <!-- <button type="object" name="button_add_to_option" string="Add to option" class="oe_stat_button"
                                attrs="{'invisible': [('is_present', '=', False)]}">
                            </button> -->
                            <!-- <button name="button_add_to_option"
                                type="object"
                                class="oe_link"
                                icon="fa-regular fa-shopping-cart"
                                string=
                                title="Add to option"
                                attrs="{'invisible': [('is_present', '=', False)]}"/> -->
                        </tree>
                    </field>
                </page>
            </page>


                <xpath expr="//div[hasclass('oe_button_box')]" position="inside">

                    <button name="action_show_manufactured_order" icon="fa-pencil-square-o" type="object" string="Fabrication" attrs="{'invisible': [('state', '!=', 'sale')]}" class="oe_highlight"/>

                </xpath>

                <xpath expr="//field[@name='date_order']" position="after">
                    <field name="date_of_last_version" widget="date" readonly='1' force_save='1'/>      
                </xpath>
                
                <xpath expr="//field[@name='sale_order_template_id']" position="after">

                    <field name="rfrence_du_dossier" readonly='1' force_save='1'/>
                    <field name="version_du_devis"/>
                    
                </xpath>


                <!-- <xpath expr="//field[@name='sale_order_template_id']" position="after">

                    <button name="generate_bom_order" attrs="{ 'invisible': [('state', '!=', 'draft')] }" string="Encryption" type="object" class="oe_highlight"/>

                </xpath> -->

                <xpath expr="//field[@name='payment_term_id']" position="after">

                    <field name="date_of_exhibition" attrs="{'readonly': [('state','not in',['draft','sent'])]}"/>
                    <field name="picking_id" readonly="1" force_save="1"/>
                    <field name="validity_quotation" readonly="1" invisible="1"/>
                    <field name="is_bom_generated" invisible="1"/>


                </xpath>

                <xpath expr="//field[@name='sale_order_nesil_option_ids']/tree/field[@name='name']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath>

                <xpath expr="//field[@name='sale_order_nesil_option_ids']/tree/field[@name='uom_id']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath>

                <xpath expr="//field[@name='sale_order_nesil_option_ids']/tree/field[@name='price_unit']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath>

                <!-- <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='uom_id']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath> -->
                <!-- <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='price_unit']" position="attributes">

                    <attribute name="invisible">1</attribute>
                </xpath> -->

                <!-- <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='name']" position="attributes">

                    <attribute name="invisible">1</attribute>

                </xpath> -->

                <!-- <xpath expr="//field[@name='sale_order_option_ids']/tree/button[@name='button_add_to_order']" position="replace">

                    <button type="object" name="button_add_to_order" string="Add to numbering" class="oe_stat_button"
                    >
                    </button>

                </xpath> -->
                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="domain">[('is_bom_parent', '=', True)]</attribute>
                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='quantity']" position="before">
                    <!-- <field name="is_subcontracted" invisible="1"/> -->
                    <field name="state" invisible="1"/>
                    <!-- <button name="action_costing_option" string=" " type="object" title="Chiffrer" class="fa fa-shopping-cart" attrs="{ 'invisible': ['|','|',('state', '!=', 'draft'),('is_subcontracted','=',True),('is_present','=',True)] }" /> -->
                    <button name="action_costing_option" string=" " type="object" title="Chiffrer" class="fa fa-shopping-cart" attrs="{ 'invisible': ['|',('state', '!=', 'draft'),('is_present','=',True)] }" />
                </xpath>

                <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='price_unit']" position="attributes">

                    <attribute name="string">Prix unitaire (hors taxe)</attribute>

                </xpath>

                <!-- <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='product_id']" position="replace">
                        <field name="order_line_id" domain="[('order_id', '=', parent.id),('display_type', '=', False)]" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                        <field name="nomenclature_name" optional="show"/>
                        <field name="product_id_domain" invisible="1"/>
                        <field name="product_id" string='Article' domain="product_id_domain" options="{'no_create': True, 'no_create_edit':True}" />
                        <field name="purchase_price"/>
                </xpath> -->
                <!-- <xpath expr="//field[@name='sale_order_option_ids']/tree/field[@name='quantity']" position="after">
                    <field name="margin_product" string =" Ratios"/>
                    <field name="total_purchase_price" force_save = "1"/>
                    <field name="total_sale_price" force_save = "1"/>
                    <field name="margin" force_save = "1"/>
                    <field name="margin_percent" widget="percentage" force_save = "1"/>
                </xpath> -->


                <!-- manage action button to transform odoo option to nesil option vice versa -->
                <xpath expr="//field[@name='sale_order_option_ids']/tree/button[@name='button_add_to_order']" position="replace">

                    <button name="button_add_to_order"
                        string="Valider option"
                        title="Add to order lines"
                        type="object"
                        attrs="{'invisible': [('is_present', '=', True)]}"/>

                </xpath>
                <xpath expr="//field[@name='sale_order_option_ids']/tree/button[@name='button_add_to_order']" position="before">
                    <field name="price_subtotal" readonly="1" force_save="1" optional="show"/>
                </xpath>

                <xpath expr="//field[@name='sale_order_nesil_option_ids']/tree/field[@name='product_id']" position="before">
                    <field name="order_line_id" domain="[('order_id', '=', parent.id),('display_type', '=', False)]" options="{'no_create': True, 'no_create_edit':True}" optional="hide"/>
                    <field name="nomenclature_name" optional="show"/>
                </xpath>

                <xpath expr="//field[@name='sale_order_nesil_option_ids']/tree/field[@name='discount']" position="after">
                    <field name="line_type" widget="selection_badge" optional="show"/>
                </xpath>

                <xpath expr="//field[@name='sale_order_nesil_option_ids']/tree" position="attributes">
                    <attribute name="default_order">nomenclature_name asc</attribute>
                </xpath>

                <xpath expr="//field[@name='sale_order_nesil_option_ids']/tree/field[@name='quantity']" position="before">
                    <field name="purchase_price" />

                </xpath>
                <!-- <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="after">
                     <button name="button_add_to_nesil_option"
                        string="Ajouter en option"
                        type="object"
                        attrs="{'invisible': [('state', '!=', 'draft')]}"/>

                </xpath> -->

                <!-- always show sale_order_nesil_option_ids -->
                <xpath expr="//page[@name='optional_products_nesil']" position="attributes">
                    <attribute name="attrs">{'readonly':[('state','=',['cancel'])]}</attribute>
                </xpath>


                <!-- <xpath expr="//field[@name='sale_order_nesil_option_ids']/tree/field[@name='quantity']" position="after">
                    <field name="margin_product" string =" Ratios"/>
                    <field name="total_purchase_price" force_save = "1"/>
                    <field name="total_sale_price" force_save = "1"/>
                    <field name="margin" force_save = "1"/>
                    <field name="margin_percent" widget="percentage" force_save = "1"/>
                </xpath> -->

                <xpath expr="//field[@name='sale_order_nesil_option_ids']" position="after">
                    <group name="note_group" col="6" class="mt-2 mt-md-0">
                        <group colspan="4">

                        </group>

                        <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">

                            <field name="total_purchase"  widget ="monetary" force_save="1"/>

                            <field name="total_sale"  widget ="monetary" force_save="1"/>

                            <field name="margin"  widget ="monetary" force_save="1"/>

                            <field name="margin_percent" widget ="percentage" force_save="1"/>

                        </group>
                        <div class="clearfix"/>
                    </group>
                </xpath>
                <!-- Calcul de totaux dans les options -->
                <xpath expr="//field[@name='sale_order_option_ids']" position="after">
                    <group name="note_group" col="6" class="mt-2 mt-md-0">
                        <group colspan="4">

                        </group>

                        <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">

                            <field name="total_purchase_option"  widget ="monetary" force_save="1"/>

                            <field name="total_sale_option"  widget ="monetary" force_save="1"/>

                            <field name="margin_option"  widget ="monetary" force_save="1"/>

                            <field name="margin_percent_option" widget ="percentage" force_save="1"/>

                        </group>
                        <div class="clearfix"/>
                    </group>
                </xpath>


                <!-- hide field in order line -->
                <xpath expr="//field[@name='order_line']/tree/field[@name='product_template_id']" position="attributes">
                    <attribute name="domain">['|', ('is_bom_parent', '=', True),('detailed_type', '=', 'service')]</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/form/group/group/div[@name='ordered_qty']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//page/field[@name='order_line']/tree/field[@name='product_uom'][2]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='customer_lead']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='product_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="attributes">
                    <attribute name="invisible">1</attribute>
                    <attribute name="force_save">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/tree/field[@name='qty_delivered']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>

                <!-- add cunsumable-->
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_subtotal']" position="before">

                    <field name="consumable" readonly="1" force_save="1" />
                </xpath>

                <!-- add custom qty -->
                <xpath expr="//field[@name='order_line']/tree/field[@name='price_unit']" position="before">

                    <field name="qty" attrs="{ 'readonly': [('state', '!=', 'draft')] }" />
                    <field name="temp_price_unit" force_save="1" readonly="1"/>
                    <field name="action_on_order_line" optional="hide"/>

                </xpath>

                <!-- change name -->
                <xpath expr="//page[@name='optional_products']" position="attributes">

                    <attribute name="string">Options</attribute>

                </xpath>
                <xpath expr="//page[@name='order_lines']" position="attributes">

                    <attribute name="string">Details of the quotation</attribute>

                </xpath>

                <!-- add button for costing table -->
                <xpath expr="//field[@name='order_line']/tree/field[@name='qty']" position="before">
                    <!-- <field name="is_subcontracted" invisible="1"/> -->
                    <!-- <button name="action_costing" string=" " type="object" title="Chiffrer" class="fa fa-shopping-cart" attrs="{ 'invisible': ['|',('state', '!=', 'draft'),('is_subcontracted','=',True)] }" /> -->
                    <button name="action_costing" string=" " type="object" title="Chiffrer" class="fa fa-shopping-cart" attrs="{ 'invisible': ['|', ('state', '!=', 'draft'), ('action_on_order_line', 'in', ['option','subcontracted'])]}" />
                </xpath>

                <xpath expr="//notebook/page[@name='optional_products']" position="after">
                    <page name="subcontractor" string="Sous-traitant">
                        <field name="sale_order_subcontractor_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="product_template_id" domain="[('is_bom_parent', '=', True)]"/>

                                <field name="partner_id" domain="[('is_subcontractors', '=', True)]" options="{'no_open': True, 'no_create':True}" />

                                <field name="cost_price"/>
                                
                                <field name="unit_price"/>
                                
                                <field name="order_line_created" invisible="1"/>
                                
                                <button name="action_create_order_line" string= "Sous-traiter"  type="object" attrs="{ 'invisible': [('order_line_created', '=', True)]}"/>

                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>

        <record id="view_order_form_inherit_sale_project_inherited" model="ir.ui.view">
            <field name="name">sale.order.form.sale.project</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="industry_fsm_sale.view_order_form_inherit_sale_project"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/tree/field[@name='task_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_quotation_tree_with_onboarding_inherited" model="ir.ui.view">
            <field name="name">sale.order.tree.sale.nesil</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_quotation_tree_with_onboarding"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_total']" position="after">
                    <field name="amount_to_pay" sum="Total reste à payer"/>
                </xpath>
            </field>
        </record>

        <record id="sale_order_filter_nesil" model="ir.ui.view">
            <field name="name">sale.order.search.nesil</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.sale_order_view_search_inherit_quotation"/>
            <field name="arch" type="xml">
                <xpath expr="//filter[@name='my_quotation']" position="after">
                    <separator/>
                    <filter string="Sous-traitant" name="subcontract" domain="[('sale_order_subcontractor_ids','!=', False)]"/>
                    <separator/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
<odoo>
    <data>
        <record model="ir.ui.view" id="product_template_only_form_view_inherit">
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="before">
                    <field name="margin_product" readonly="0"/>
                    <field name="margin_product_euro" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                    <field name="is_bom_parent" invisible="1"/>
                    <field name="is_subcontracted" invisible="1"/>
                </xpath>
            </field>
        </record>

        <record id="product_normal_form_view_inherit_product_product" model="ir.ui.view">
            <field name="name">product.product.view.form.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='default_code']" position="before">
                    <field name="margin_product" readonly="0"/>
                    <field name="margin_product_euro" readonly="1" force_save="1" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                    <field name="is_bom_parent" invisible="1"/>  
                    <field name="is_subcontracted" invisible="1"/>           
                </xpath>
            </field>
        </record>
    </data>
</odoo>
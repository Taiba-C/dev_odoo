<odoo>
    <data>
        <record model="ir.ui.view" id="product_template_only_form_view_inherit">
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_only_form_view" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="before">
                    <field name="margin_percent"/>
                    <field name="margin_product" readonly="1" force_save="1"/>
                    <field name="is_bom_parent" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='standard_price']" position="attributes">
                    <attribute name="string">Purchase price</attribute>
                </xpath>
            </field>
        </record>

        <record id="product_normal_form_view_inherit_product_product" model="ir.ui.view">
            <field name="name">product.product.view.form.inherit</field>
            <field name="model">product.product</field>
            <field name="inherit_id" ref="product.product_normal_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='categ_id']" position="before">
                    <field name="is_bom_parent" invisible="1"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
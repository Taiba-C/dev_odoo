<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="project_view_form_inherit_project" model="ir.ui.view">
        <field name="name">project.view.form.inherit.project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="order_id" force_save="True" attrs="{}" readonly="1"/>
            </xpath>
            <xpath expr="//form[1]/sheet[1]/notebook[1]" position="inside">
                <page string="Salon" >
                    <group>
                        <group name="info_left_show">
                            <field name="show_name"/>
                            <field name="show_localisation"/>
                            <field name="show_stand_name"/>
                            <field name="show_hall_name"/>
                        </group>
                        <group name="info_rigth_show">
                            <field name="show_dates"/>
                            <field name="show_surface"/>
                        </group>
                    </group>
                </page>
                <page string="Montage / Démontage" >
                    <group>
                        <group name="info_left">
                            <field name="assembly_date_start" string="Début du montage" widget="daterange" options="{'related_end_date': 'assembly_date_end'}"/>
                            <field name="assembly_date_end" string="au" widget="daterange" options="{'related_start_date': 'assembly_date_start'}"/>
                        </group>
                        <group name="info_rigth">
                            <field name="disassembly_date_start" string="Début du démontage" options="{'related_end_date': 'disassembly_date_end'}"/>
                            <field name="disassembly_date_end" string="au" options="{'related_start_date': 'disassembly_date_start'}"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>


</odoo>
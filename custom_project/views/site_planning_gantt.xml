<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="view_project_site_planning_gantt" model="ir.ui.view">
        <field name="name">project.project.select</field>
        <field name="model">project.project</field>
        <field name="arch" type="xml">
            <search string="Search Project">

                <group expand="0" string="Group By">
                    <filter string="Stage" name="groupby_partner_id" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>


    <record id="project_site_plannging_gantt" model="ir.ui.view">
        <field name="name">project.project.view.gantt</field>
        <field name="model">project.project</field>
        <field name="priority">10</field>
        <field name="arch" type="xml">
            <gantt date_start="date_start" 
                    date_stop="date" 
                    default_scale="month" 
                    scales="week,month,year" 
                    color="color" 
                    string="Planning"
                    create="false" 
                    display_unavailability="1" 
                    precision="{'week': 'day:full', 'month': 'day:full'}" 
                    default_group_by="user_id" 
                    thumbnails="{'user_id': 'avatar_128'}" >
                <templates>
                    <div t-name="gantt-popover">
                        <div t-if="partner_id">
                             <strong>Customer — </strong>
                            <t t-esc="partner_id[1]"/>
                        </div>
                        <div t-if="show_name">
                            <strong>Show name — </strong>
                            <t t-esc="show_name"/>
                        </div>
                        <div t-if="show_dates">
                            <strong>Show dates — </strong>
                            <t t-esc="show_dates"/>
                        </div>
                        <div t-if="show_localisation">
                            <strong>Localisation — </strong>
                            <t t-esc="show_localisation"/>
                        </div>
                        <div t-if="show_hall_name">
                            <strong>Hall — </strong>
                            <t t-esc="show_hall_name"/>
                        </div>
                        <div t-if="show_stand_name">
                            <strong>Stand N — </strong>
                            <t t-esc="show_stand_name"/>
                        </div>
                        <div t-if="show_surface">
                            <strong>Surface — </strong>
                            <t t-esc="show_surface"/>
                        </div>
                        <div t-if="show_commercials">
                            <strong>Vendor — </strong>
                            <t t-esc="show_commercials"/>
                        </div>
                        <div t-if="assembly_date_end and disassembly_date_start">
                            <div>
                                <strong>Date de montage: </strong>
                                <t t-esc="assembly_date_start.format(' l LT')"/>
                                    <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                                <t t-esc="assembly_date_end.format(' l LT')"/>
                            </div>
                            <div>
                                <strong>Date de demontage: </strong>
                                <t t-esc="disassembly_date_start.format(' l LT')"/>
                                <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow"/>
                                <t t-esc="disassembly_date_end.format(' l LT')"/>
                            </div>
                        </div>
                        <hr/>

                        <!-- <div >
                            <t t-esc="userTimezoneStartDate.format('l ')"/>
                            <i class="fa fa-long-arrow-right" title="Arrow"/>
                            <t t-esc="userTimezoneStopDate.format(' l')"/>
                        </div> -->
                    </div>
                </templates>
                <field name="user_id"/>
                <field name="partner_id"/>
                <field name="show_name"/>
                <field name="show_dates"/>
                <field name="show_localisation"/>
                <field name="show_hall_name"/>
                <field name="show_stand_name"/>
                <field name="show_surface"/>
                <field name="show_commercials"/>
                <field name="assembly_date_start"/>
                <field name="assembly_date_end"/>
                <field name="disassembly_date_start"/>
                <field name="disassembly_date_end"/>
            </gantt>
        </field>
    </record>



    <!-- ACTION GANTT -->
    <record id="action_open_view_project_site_planning" model="ir.actions.act_window">
        <field name="name">site_planning des projets</field>
        <field name="res_model">project.project</field>
        <field name="context">{'search_default_groupby_partner_id': 1}</field>
        <field name="view_mode">gantt</field>
        <field name="view_id" ref="project_site_plannging_gantt"/>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="view_project_site_planning_gantt"/>
        <field name="target">main</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                        No projects found. Let's create one!
            </p>
            <p>
                        Projects contain tasks on the same topic, and each has its own dashboard.
            </p>
        </field>
    </record>

    <!-- <menuitem id="menu_site_planning_gantt"
                name="Planning lié aux chantiers"   
                web_icon="custom_project,static/description/site_planning.png" 
                action="action_open_view_project_site_planning"/>-->
</odoo>
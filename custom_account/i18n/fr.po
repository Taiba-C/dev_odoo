#. module: custom_account
#: model:mail.template,body_html:custom_account.email_template_followup_1
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">Dear <t t-out=\"object.name or ''\"></t> (<t t-out=\"object.commercial_partner_id.name or ''\"></t>),</t>\n"
"                        <t t-else=\"\">Dear <t t-out=\"object.name or ''\"></t>,</t>\n"
"                        <br>\n"
"                    </p>\n"
"                    <p>\n"
"                        Exception made if there was a mistake of ours, it seems that an amount of <t t-out=\"format_amount(object.total_overdue, object.currency_id) or ''\"></t>\n"
"                        stays unpaid. Please, take appropriate measures in order to carry out this payment in the next 8 days.\n"
"                    </p>\n"
"                    <p>\n"
"                        Would your payment have been carried out after this mail was sent, please ignore this message.\n"
"                        Do not hesitate to contact our accounting department.\n"
"                    </p>\n"
"                    <p>\n"
"                        Best Regards,\n"
"                        \n"
"                        <t t-if=\"not is_html_empty(object._signature_malika().signature)\">\n"
"                            <br>\n"
"                            <t t-out=\"object._signature_malika().signature\"></t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <br>\n"
"                            --\n"
"                            <br>\n"
"                            <t t-out=\"object._signature_malika().name\"></t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <t t-if=\"object.id != object.commercial_partner_id.id\">Cher <t t-out=\"object.name or ''\"></t> (<t t-out=\"object.commercial_partner_id.name or ''\"></t>),</t>\n"
"                        <t t-else=\"\">Cher <t t-out=\"object.name or ''\"></t>,</t>\n"
"                        <br>\n"
"                    </p>\n"
"                    <p>\n"
"                        Sauf erreur de notre part, il semble qu'un montant de <t t-out=\"format_amount(object.total_overdue, object.currency_id) or ''\"></t>\n"
"                        reste impayé. Veuillez prendre les mesures appropriées pour effectuer ce paiement dans les 8 prochains jours.\n"
"                    </p>\n"
"                    <p>\n"
"                        Si votre paiement a été effectué après l'envoi de ce mail, veuillez ignorer ce message.\n"
"                        N'hésitez pas à contacter notre service comptabilité.\n"
"                    </p>\n"
"                    <p>\n"
"                        Cordialement,\n"
"                        \n"
"                        <t t-if=\"not is_html_empty(object._signature_malika().signature)\">\n"
"                            <br>\n"
"                            <t t-out=\"object._signature_malika().signature\"></t>\n"
"                        </t>\n"
"                        <t t-else=\"\">\n"
"                            <br>\n"
"                            --\n"
"                            <br>\n"
"                            <t t-out=\"object._signature_malika().name\"></t>\n"
"                        </t>\n"
"                    </p>\n"
"                </div>\n"
"            "


#. module: custom_account
#: model:mail.template,body_html:custom_account.email_template_invoice_of_balance_before
msgid ""
"<div style=\"margin: 0px; padding: 0px;\">\n"
"                    <p style=\"margin: 0px; padding: 0px; font-size: 13px;\">\n"
"                        <t t-set=\"doc_name\" t-value=\"'quotation' if object.state in ('draft', 'sent') else 'order'\"></t>\n"
"                        Bonjour,\n"
"                        <br>\n"
"                        <br>\n"
"\n"
"                        \n"
"                        Nous vous avons adressé notre facture <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">FA……</span> (référence: <t t-out=\"ctx.get('opportunity_name') or ''\"></t>)  d'un montant de <span style=\"font-weight:bold;\" t-out=\"format_amount(object.amount_total, object.currency_id) or ''\">$ 143,750.00</span>, en\n"
"                        date du <span style=\"font-weight: bold;\" t-out=\"object.invoice_date or ''\">date de la facture</span>\n"
"                        <br>\n"
"                        <br>\n"
"                        Nous vous rappelons que celle-ci est à échéance le <span style=\"font-weight: bold;\" t-out=\"object.invoice_date_due or ''\">date d'echéance de la facture</span> \n"
"                        C’est pourquoi nous vous invitions à effectuer le règlement.\n"
"                        <br>\n"
"                        <br>\n"
"                        Merci de rappeler la référence suivante lors du paiement <span style=\"font-weight: bold;\" t-out=\"object.name or ''\">FA……</span>\n"
"                        <br>\n"
"                        <br>\n"
"\n"
"                        Nous restons bien entendu à votre entière disposition pour tout complément d'information,\n"
"                        Bien cordialement,\n"
"\n"
"                        La comptabilité, \n"
"                        <br>\n"
"                        <t t-if=\"not is_html_empty(object.user_id.signature)\">\n"
"                            <br>\n"
"                            <br>\n"
"                            <t t-out=\"ctx.get('signature_malika').signature or ''\">--                                <br>\n"
"                                MALIKA \n"
"                            </t>\n"
"                        </t>\n"
"                        <br>\n"
"                        <br>\n"
"                    </p>\n"
"                </div>\n"
"            "
msgstr ""


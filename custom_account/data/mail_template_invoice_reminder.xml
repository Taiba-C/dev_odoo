<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_invoice_of_balance_later" model="mail.template">
            <field name="name">Facturation: MODELE ENVOI RAPPEL FACTURE DE SOLDE APRES</field>
            <field name="model_id" ref="custom_account.model_account_move"/>
            <field name="email_from">compta@nesilfrance.com</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="subject">{{ object.company_id.name }} Facture (Ref {{ object.name or 'n/a' }}) {{ctx.get('opportunity_name') or ''}} </field>
            <field name="description">4 JOURS APRES LA DATE D’ECHEANCE</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <t t-set="doc_name" t-value="'quotation' if object.state in ('draft', 'sent') else 'order'"/>
                        Cher <span t-out="object.partner_id.name or ''">.....</span>,
                        <br/>
                        <br/>
                        Veuillez trouver ci-joint votre facture <span style="font-weight: bold;" t-out="object.name or ''">FA……</span> (référence: <t t-out="ctx.get('opportunity_name') or ''"></t>)  d'un montant de <span style="font-weight:bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 143,750.00</span>, émise par Nesil France. 
                        <br/>
                        La date d’échéance de votre facture est le <span style="font-weight: bold;" t-out="object.invoice_date_due or ''">(date d'echéance de la facture)</span>
                        <br/>
                        Merci de rappeler la référence suivante lors du paiement : <span style="font-weight: bold;" t-out="object.name or ''">FA……</span>
                        <br/>
                        Nous restons bien entendu à votre entière disposition pour tout complément d'information,
                        <br/>
                        <br/>
                        Bien cordialement,
                        <br/>
                        La comptabilité, 
                        <br/>
                        <br/>
                        <t t-out="ctx.get('signature_malika').signature or ''">--                            <br/>
                            MALIKA 
                        </t>
                        <br/>
                        <br/>

                    </p>
                </div>
            </field>
        </record>


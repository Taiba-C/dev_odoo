        <record id="email_template_out_refund_invoice" model="mail.template">
            <field name="name">Facture d'avoir  : MODELE ENVOI AVOIR</field>
            <field name="model_id" ref="custom_account.model_account_move"/>
            <field name="email_from">compta@nesilfrance.com</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="subject">{{ object.company_id.name }} AVOIR (Ref {{ object.name or 'n/a' }}) {{object.get_account_move(object.id).get('opportunity_name')}}</field>
            <field name="description">4 JOURS APRES LA DATE DE CREATION DE LA FACTURE</field>
            <field name="body_html" type="html">
                <t t-set="account_move" t-value="object.get_account_move(object.id)"/>
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        <t t-set="doc_name" t-value="'quotation' if object.state in ('draft', 'sent') else 'order'"/>
                        Cher <span t-out="object.partner_id.name or ''">partner</span>,
                        <br/>
                        <br/>
                        Veuillez trouver ci-joint votre AVOIR  <span style="font-weight: bold;" t-out="object.name or ''">FA……</span> d'un montant de <span style="font-weight:bold;" t-out="format_amount(object.amount_total, object.currency_id) or ''">$ 143,750.00</span>, émise par Nesil France.
                        <br/>
                        <br/>
                        Nous restons bien entendu à votre entière disposition pour tout complément d'information,
                        Bien cordialement,
                        <br/>
                        La comptabilité, 
                        <br/>
                        <br/>

                        <t t-out="account_move.get('signature_malika').signature or ''">--                            <br/>
                            MALIKA 
                        </t>

                        <br/>
                        <br/>


                    </p>
                </div>
            </field>
            <field name="report_template" ref="account.account_invoices"/>
            <field name="report_name">Invoice_{{ (object.name or '').replace('/','_') }}{{ object.state == 'draft' and '_draft' or '' }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>

        </record>



    </data>


</odoo>
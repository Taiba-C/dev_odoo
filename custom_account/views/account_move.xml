<odoo>
    <data>
        <record id="view_move_form_inherited" model="ir.ui.view">
            <field name="name">account_move_inherited</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                
                <xpath expr="//field[@name='payment_reference']" position="after">
                    <field name="invoice_types" force_save="1"/>
                </xpath>
                
            </field>
        </record>

        <menuitem name="Raccourcis" parent="account_accountant.menu_accounting" id="menu_raccourcis_accounting" groups="account.group_account_readonly,account.group_account_invoice" sequence="21"/>

        <menuitem
            id="sale_order_menu_accounting"
            name="Devis"
            action="sale.action_quotations_with_onboarding"
            groups="account.group_account_readonly,account.group_account_invoice"
            parent="menu_raccourcis_accounting"
            sequence="0"
            />

        <menuitem
                id="document_menu_accounting"
                name="Document"
                action="documents.document_action"
                groups="account.group_account_readonly,account.group_account_invoice"
                parent="menu_raccourcis_accounting"
                sequence="1"

                />

        <menuitem
            id="crm_menu_accounting"
            name="CRM"
            action="crm.action_your_pipeline"
            groups="account.group_account_readonly,account.group_account_invoice"
            parent="menu_raccourcis_accounting"
            sequence="2"
            />


        <menuitem
            id="sale_order_menu_accounting"
            name="Planning"
            action="planning.planning_action_my_calendar"
            groups="account.group_account_readonly,account.group_account_invoice"
            parent="menu_raccourcis_accounting"
            />
    </data>
</odoo>
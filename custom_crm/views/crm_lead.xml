<odoo>
    <data>
        <record id="crm_lead_view_form_inherit_crm_lead" model="ir.ui.view">
            <field name="name">crm.lead.view.form.inherit</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.crm_lead_view_form"/>
            <field name="arch" type="xml">
                <sheet> 
                    <div role="alert" classe="alert alert-danger" style="height:40px;width:50px;margin-bottom:1px" attrs="{'invisible': [('warning_copy','!=', False)]}" > La date de debut de salon est dépassée  </div>
                </sheet>
                <xpath expr="//field[@name='user_id']" position="after">
                    <field name="warning_copy" invisible ="1" />
                    <field name="is_quotation_created" invisible ="1" />
                </xpath>
                <xpath expr="//button[@name='action_sale_quotations_new']" position="attributes">
                    <attribute name="attrs">{'invisible': [('is_quotation_created','!=', False)]}</attribute>
                </xpath>
                <xpath expr="//button[@name='action_set_won_rainbowman']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//button[@name='%(crm.crm_lead_lost_action)d']" position="attributes">
                    <attribute name="attrs">{'invisible': [('stage_id','not in',[1,2] )]}</attribute>
                </xpath>
                    
                <xpath expr="//page[@name='internal_notes']" position="before">
                    <page string="Salon">
                        <group>
                            <group>
                            <field name="salon" />
                            <field name="lieu_du_salon" />
                            <field name="stand_n" />
                            <field name="hall" />
                            </group>
                            <group>
                                <field name="dbut_salon" widget="daterange" options="{'related_end_date': 'fin_salon'}"/>
                                <field name="fin_salon" widget="daterange" options="{'related_start_date': 'dbut_salon'}"/>
                                <field name="allee" />
                                <field name="surface_en_m" />
                            </group>
                        </group>
                    </page>   
                    <page string="Remarques">
                        <group>
                            <group>
                            <field name="remarques" />
                            </group>
                        </group>
                    </page>   
                    <page string="Montage/Démontage ">
                        <group>
                            <group>
                            <field name="date_de_montage_du" widget="daterange" options="{'related_end_date': 'date_de_montage_au'}"/>
                            <field name="date_de_montage_au" widget="daterange" options="{'related_start_date': 'date_de_montage_du'}"/>
                            <field name="remarques_montage" />
                            </group>
                            <group>
                            <field name="date_de_demontage_du" widget="daterange" options="{'related_end_date': 'date_de_demontage_au'}"/>
                            <field name="date_de_demontage_au" widget="daterange" options="{'related_start_date': 'date_de_demontage_du'}"/>
>
                            </group>
                        </group>
                    </page>  
                </xpath>
                

            </field>
        </record>
            <record id="quick_create_opportunity_form_custom" model="ir.ui.view">
            <field name="name">crm.lead.oppordtunit.quick.form</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='name']" position="attributes">
                    <attribute name="string">Dossier</attribute>
                </xpath>
            </field>
        </record>
          <record id="quick_create_opportunity_form_custom_budget" model="ir.ui.view">
            <field name="name">crm.lead.oppordtunit.quick.form</field>
            <field name="model">crm.lead</field>
            <field name="inherit_id" ref="crm.quick_create_opportunity_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='expected_revenue']" position="attributes">
                    <attribute name="string">Budget</attribute>
                </xpath>
            </field>
        </record>      
    </data>
</odoo>